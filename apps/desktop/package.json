{
  "name": "desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Electron desktop shell for SagaSpine",
  "author": "SagaSpine",
  "type": "commonjs",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test": "vitest run",
    "start": "electron ./dist/main/main.js",
    "start:dev": "VITE_DEV_SERVER_URL=http://localhost:5173 electron ./dist/main/main.js",
    "package": "electron-builder",
    "package:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.11",
    "@typescript/native": "npm:typescript@^7.0.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.7",
    "electron-builder-squirrel-windows": "^26.15.7",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.worldbuildingdesk.app",
    "productName": "SagaSpine",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "renderer",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
