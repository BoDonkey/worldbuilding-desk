{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @litrpg-tool/rules-engine build",
    "dev": "vite",
    "prebuild": "pnpm --filter @litrpg-tool/rules-ui... build",
    "build": "tsc -b && vite build",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "test:unit": "vitest run",
    "preview": "vite preview",
    "e2e:open": "cypress open",
    "e2e:run": "cypress run"
  },
  "dependencies": {
    "@litrpg-tool/rules-engine": "workspace:*",
    "@litrpg-tool/rules-ui": "workspace:*",
    "@tiptap/core": "^3.23.6",
    "@tiptap/extension-text-style": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "@huggingface/transformers": "^4.2.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "idb": "^8.0.3",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.41.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "word-list-google": "^1.0.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.11",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "cypress": "^15.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "~7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
